# Copiar este archivo como .env y completar los valores. Nunca subir .env al repositorio.

PORT=3000

# Supabase > Project Settings > API
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Usar la "service_role" key (secreta). Solo vive en el servidor, nunca en la app Android.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Secreto para firmar los tokens de sesión (cadena larga y aleatoria)
JWT_SECRET=<cadena-aleatoria-larga>
JWT_EXPIRA_EN=7d

# Zona horaria usada para calcular "el mes actual" en resumen y sugerencias
ZONA_HORARIA=America/Bogota

# Orígenes permitidos por CORS (separados por coma). Vacío = todos.
CORS_ORIGEN=
